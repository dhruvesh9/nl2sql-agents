# Folder with index.md, graph.json, and runbooks/.
KNOWLEDGE_BASE_DIR=knowledge_base
# POST /generate reads the table catalog from db-service.
DB_SERVICE_URL=http://localhost:8001
DB_SERVICE_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
# json = one JSON object per line (production). text = easy to read in a terminal.
LOG_FORMAT=json
