TOGETHER_API_KEY=
# Check the current Together model list before you change this.
LLM_MODEL=Qwen/Qwen3.8-Flash
LLM_TEMPERATURE=0
# Reasoning options work only with a reasoning model (like Qwen3.8-Flash). Turning thinking off
# makes a call much faster. For another model, delete every REASONING_ENABLED line.
LLM_REASONING_ENABLED=false
# Settings for each agent. Format: <AGENT>__<OPTION>. An option that you do not set uses the default above.
# Options: MODEL, TEMPERATURE, TOP_P, TOP_K, REASONING_ENABLED.
# Agents: QUERY_ANALYZER, TABLE_CLASSIFIER, TABLE_FEEDBACK, SQL_GENERATOR, SQL_VALIDATOR.
QUERY_ANALYZER__REASONING_ENABLED=false
TABLE_CLASSIFIER__REASONING_ENABLED=true
# TABLE_CLASSIFIER__TEMPERATURE=0
# TABLE_CLASSIFIER__TOP_P=0.9
# TABLE_CLASSIFIER__TOP_K=40
# QUERY_ANALYZER__MODEL=<a smaller, faster model>
# Must match the SERVICE_API_KEY of db-service.
DB_SERVICE_URL=http://localhost:8001
DB_SERVICE_API_KEY=change-me
DB_SERVICE_TIMEOUT_SECONDS=30
# knowledge-service owns the knowledge base. The key must match its SERVICE_API_KEY.
KNOWLEDGE_SERVICE_URL=http://localhost:8002
KNOWLEDGE_SERVICE_API_KEY=change-me
KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=10
# How long we keep a knowledge text before we ask the service again.
KNOWLEDGE_CACHE_TTL_SECONDS=300
FK_DEPTH=1
MAX_TABLE_ATTEMPTS=3
MAX_SQL_ATTEMPTS=3
PASS_SCORE=80
LOG_LEVEL=INFO

# Langfuse tracing. Off by default. The app works without these keys.
# Create a free project at https://cloud.langfuse.com and copy the keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
