# Local PostgreSQL with the read-only user (see database/init/03_readonly_user.sql).
DATABASE_URL=postgresql+psycopg://nl2sql_reader:reader_pw@localhost:5432/nl2sql

# Hosted PostgreSQL (Supabase or another provider): change only DATABASE_URL.
# Get the connection string from the provider dashboard. Add sslmode=require.
# Prefer the pooler string (it works on IPv4). Example shape:
# DATABASE_URL=postgresql+psycopg://nl2sql_reader.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Clients must send this value in the X-API-Key header.
SERVICE_API_KEY=change-me
# Stop any query that runs longer than this.
STATEMENT_TIMEOUT_MS=5000
# Row limit when the request does not set max_rows.
DEFAULT_MAX_ROWS=100
# The largest max_rows value that a request can use.
MAX_ROWS_LIMIT=1000
# The largest fk_depth value that a request can use.
MAX_FK_DEPTH=3
LOG_LEVEL=INFO
